STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-v2

# Public URL of the storefront, used to build links in emails (e.g. employee invites)
STOREFRONT_URL=http://localhost:8000

# Resend (https://resend.com) for transactional emails such as employee invites.
# When RESEND_API_KEY is empty, emails are logged to the console instead of sent.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Acme <invites@acme.com>".
# Required when RESEND_API_KEY is set.
RESEND_FROM_EMAIL=
# Development only: when set, every email is sent to this address instead of the real
# recipient (the subject notes the original). With the onboarding@resend.dev sender,
# Resend only delivers to your Resend account's email. Leave empty in production.
RESEND_TEST_RECIPIENT=
